
{
    "title": "A4Tech PC Keyboard → Mac Modifiers (Full Fix + Hyper Key)",
    "rules": [
        {
            "description": "Fix Left Side Modifiers (Alt/Win/Ctrl)",
            "manipulators": [
                {
                    "from": { "key_code": "left_control" },
                    "to": [ { "key_code": "left_control" } ],
                    "type": "basic"
                },
                {
                    "from": { "key_code": "left_gui" },
                    "to": [ { "key_code": "left_option" } ],
                    "type": "basic"
                },
                {
                    "from": { "key_code": "left_alt" },
                    "to": [ { "key_code": "left_command" } ],
                    "type": "basic"
                }
            ]
        },
        {
            "description": "Fix Right Side Modifiers (Alt | FN | Menu | Ctrl)",
            "manipulators": [
                {
                    "from": { "key_code": "right_alt" },
                    "to": [
                        {
                            "key_code": "left_shift",
                            "modifiers": ["left_command", "left_control", "left_option"]
                        }
                    ],
                    "to_if_alone": [ { "key_code": "right_command" } ],
                    "type": "basic"
                },
                {
                    "from": { "key_code": "application" },
                    "to": [ { "key_code": "right_option" } ],
                    "type": "basic"
                },
                {
                    "from": { "key_code": "right_control" },
                    "to": [ { "key_code": "right_control" } ],
                    "type": "basic"
                }
            ]
        }
    ]
}

